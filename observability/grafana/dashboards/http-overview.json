{
  "uid": "omagotchi-http",
  "title": "Omagotchi HTTP 관측",
  "description": "서비스 내부 호출을 포함한 HTTP 메트릭. 서비스별 Prometheus Endpoint 도입·운영 검증 전까지 수집 상태 확인용 초안.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Seoul",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["omagotchi", "http"],
  "templating": {
    "list": [
      {
        "name": "service", "label": "서비스", "type": "query",
        "datasource": {"type": "prometheus", "uid": "omagotchi-prometheus"},
        "query": "label_values(up{job=~\"spring-services|prediction-service\"}, service)",
        "refresh": 1, "multi": true, "includeAll": true, "allValue": ".*",
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "route", "label": "경로", "type": "query",
        "datasource": {"type": "prometheus", "uid": "omagotchi-prometheus"},
        "query": "label_values(http_server_requests_seconds_count{job=\"spring-services\",service=~\"$service\",uri!~\"/actuator.*\"}, uri)",
        "refresh": 1, "multi": true, "includeAll": true, "allValue": ".*",
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "text", "title": "조회 기준",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3},
      "options": {
        "mode": "markdown",
        "content": "서비스 간 호출을 포함한 집계로, 서비스별 요청 수를 더한 값은 외부 사용자 요청 수가 아님. **No data는 정상 0건이 아니라 미수집·조회 구간 부재 가능성.** 수집 상태는 서비스 필터만 적용. Prediction HTTP 메트릭은 계약 확정 전 집계 제외."
      }
    },
    {
      "id": 2, "type": "table", "title": "Endpoint 수집 상태",
      "description": "1: 최근 Scrape 성공, 0: 실패. 프로세스 생존·업무 정상 여부와 별개. 서비스 계측 미반영 대상의 0은 예상 상태.",
      "gridPos": {"x": 0, "y": 3, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "omagotchi-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=~\"spring-services|prediction-service\",service=~\"$service\"}", "instant": true, "format": "table"}],
      "options": {"showHeader": true},
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []}
    },
    {
      "id": 3, "type": "timeseries", "title": "초당 HTTP 요청",
      "gridPos": {"x": 8, "y": 3, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "omagotchi-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"spring-services\",service=~\"$service\",uri=~\"$route\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 4, "type": "timeseries", "title": "HTTP 5xx 비율 · 최근 5분",
      "gridPos": {"x": 16, "y": 3, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "omagotchi-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (service) (omagotchi:http_5xx:increase5m{service=~\"$service\",uri=~\"$route\"}) / clamp_min(sum by (service) (omagotchi:http_requests:increase5m{service=~\"$service\",uri=~\"$route\"}), 1)", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 5, "type": "timeseries", "title": "HTTP p95 처리 시간",
      "description": "Histogram 노출 필요. 종료된 SSE 연결 시간도 포함되므로 일반 API 비교 시 경로 필터로 분리. 진행 중인 SSE 연결의 지연 지표는 아님.",
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "omagotchi-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket{job=\"spring-services\",service=~\"$service\",uri=~\"$route\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "HTTP 오류 응답 · 상태별 초당 건수",
      "description": "4xx·5xx 응답 분포. 모든 오류를 Telegram으로 전송하는 설정은 아님.",
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "omagotchi-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (service, status) (rate(http_server_requests_seconds_count{job=\"spring-services\",service=~\"$service\",uri=~\"$route\",uri!~\"/actuator.*\",status=~\"[45]..\"}[$__rate_interval]))", "legendFormat": "{{service}} · {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "JVM Heap 사용량 · 인스턴스별",
      "description": "서비스 필터만 적용. 경로별 메모리 사용량이 아님.",
      "gridPos": {"x": 0, "y": 17, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "omagotchi-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (service, instance) (jvm_memory_used_bytes{job=\"spring-services\",service=~\"$service\",area=\"heap\"})", "legendFormat": "{{service}} · {{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "JVM GC 일시 정지 · 초당 누적 시간",
      "description": "서비스 필터만 적용. Histogram 분위수가 아닌 GC Pause 시간의 증가율.",
      "gridPos": {"x": 8, "y": 17, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "omagotchi-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (service, instance) (rate(jvm_gc_pause_seconds_sum{job=\"spring-services\",service=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{service}} · {{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 9, "type": "timeseries", "title": "프로세스 CPU 비율 · 인스턴스별",
      "description": "서비스 필터만 적용. Spring Micrometer의 process_cpu_usage 값으로, Host 전체 CPU와 다른 기준.",
      "gridPos": {"x": 16, "y": 17, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "omagotchi-prometheus"},
      "targets": [{"refId": "A", "expr": "process_cpu_usage{job=\"spring-services\",service=~\"$service\"}", "legendFormat": "{{service}} · {{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    }
  ]
}
