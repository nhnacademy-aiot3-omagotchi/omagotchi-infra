# 운영 Runtime 설정 Template
# 실제 파일: ~/omagotchi/secrets/prod.env
# JWT key 파일: ~/omagotchi/secrets/jwt-public.pem, jwt-private.pem
# 모든 Key의 명시적 선언 필수, 선택적 Credential만 빈 값 허용

CLOUDFLARED_TOKEN=change-me

# 서비스 공통 JWT 계약
JWT_ISSUER=https://identity.omagotchi.example
JWT_AUDIENCE=omagotchi-api
JWT_ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D

# Identity PostgreSQL
IDENTITY_DB_URL=jdbc:postgresql://replace-with-postgres-host:5432/identity_service
IDENTITY_DB_USERNAME=replace-with-identity-db-user
IDENTITY_DB_PASSWORD=replace-with-identity-db-password

# Identity Email Verification Redis
IDENTITY_REDIS_HOST=replace-with-redis-host
IDENTITY_REDIS_PORT=6379
IDENTITY_REDIS_DATABASE=342
IDENTITY_REDIS_USERNAME=replace-with-redis-username
IDENTITY_REDIS_PASSWORD=replace-with-redis-password
IDENTITY_REDIS_SSL_ENABLED=false

# Identity 이메일 인증 정책·HMAC
EMAIL_VERIFICATION_CODE_TTL=PT5M
EMAIL_VERIFICATION_COOLDOWN=PT1M
EMAIL_VERIFICATION_MAXIMUM_FAILED_ATTEMPTS=5
EMAIL_VERIFICATION_HMAC_SECRET=replace-with-32-or-more-character-random-secret

# Identity Email Delivery
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=Omagotchi <no-reply@omagotchi.site>
RESEND_CONNECT_TIMEOUT=PT2S
RESEND_READ_TIMEOUT=PT5S

# Identity 로그인 보호 정책
LOGIN_MAXIMUM_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=PT10M

# Learning PostgreSQL
LEARNING_DB_URL=jdbc:postgresql://replace-with-postgres-host:5432/learning_service
LEARNING_DB_USERNAME=replace-with-learning-db-user
LEARNING_DB_PASSWORD=replace-with-learning-db-password

# Learning Presence Redis
LEARNING_REDIS_HOST=replace-with-redis-host
LEARNING_REDIS_PORT=6379
LEARNING_REDIS_DATABASE=341
LEARNING_REDIS_USERNAME=replace-with-redis-username
LEARNING_REDIS_PASSWORD=replace-with-redis-password
LEARNING_REDIS_SSL_ENABLED=false

# Learning Runtime 정책
TIMER_MAX_DURATION=PT12H

# Learning AI Chat·날씨 Tool
# 복수 Gemini API Key는 쉼표로 구분
GEMINI_API_KEYS=replace-with-comma-separated-gemini-api-keys
OLLAMA_BASE_URL=http://replace-with-ollama-host:11434
KMA_SERVICE_KEY=replace-with-kma-service-key

# Learning Telegram Bot·Webhook
TELEGRAM_BOT_USERNAME=replace-with-telegram-bot-username
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-telegram-webhook-secret
TELEGRAM_LINK_TOKEN_TTL=PT10M
TELEGRAM_CONNECTION_REQUEST_TIMEOUT=PT5S
TELEGRAM_CONNECT_TIMEOUT=PT5S
TELEGRAM_READ_TIMEOUT=PT10S
COMMUNITY_ATTACHMENT_MAX_FILE_SIZE=5MB
COMMUNITY_ATTACHMENT_MAX_COUNT=5
REALTIME_PRESENCE_SESSION_TTL=60s

# 커뮤니티 첨부파일 MinIO 전환 예약값
# Learning MinIO Adapter 연결 전까지 애플리케이션에서 미사용.
MINIO_ENDPOINT=replace-with-minio-host
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=replace-with-minio-bucket

# Rule MQTT Sensor Broker
SENSOR_BROKER_URL=tcp://replace-with-sensor-broker:1883
SENSOR_USERNAME=
SENSOR_PASSWORD=

# Rule Engine 간 내부 API 인증
# engine-a와 engine-b에 동일한 값 주입
INTERNAL_SHARED_SECRET=replace-with-long-random-secret

# Learning·Rule RabbitMQ
RABBITMQ_HOST=replace-with-rabbitmq-host
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=replace-with-rabbitmq-username
RABBITMQ_PASSWORD=replace-with-rabbitmq-password

# Learning·Rule InfluxDB
INFLUXDB_URL=https://replace-with-influxdb-host
INFLUXDB_TOKEN=replace-with-influxdb-token
INFLUXDB_ORG_ID=replace-with-influxdb-org-id

# Frontend Session Redis 연결
SESSION_REDIS_HOST=replace-with-redis-host
SESSION_REDIS_PORT=6379
SESSION_REDIS_DATABASE=340
SESSION_REDIS_USERNAME=replace-with-redis-username
SESSION_REDIS_PASSWORD=replace-with-redis-password
SESSION_REDIS_SSL_ENABLED=false

# Frontend Access Token 선제 갱신과 Session별 동시 갱신 조정
ACCESS_TOKEN_REFRESH_BEFORE_EXPIRY=30s
ACCESS_TOKEN_REFRESH_LOCK_WAIT_TIMEOUT=20s
ACCESS_TOKEN_REFRESH_LOCK_POLL_INTERVAL=250ms
ACCESS_TOKEN_REFRESH_LOCK_LEASE=45s

# Frontend -> Identity 내부 인증 API의 공유 Credential
FRONTEND_USERNAME=frontend
FRONTEND_PASSWORD=replace-with-32-to-72-byte-secret

# Learning -> Identity 계정 조회 API의 관계 전용 Credential
LEARNING_IDENTITY_USERNAME=learning-service
LEARNING_IDENTITY_PASSWORD=replace-with-32-to-72-byte-secret

# Rule -> Learning 임계치 기준 조회 API의 관계 전용 Credential
RULE_LEARNING_USERNAME=rule-service
RULE_LEARNING_PASSWORD=replace-with-32-to-72-byte-secret

# Learning -> Prediction 공부시간 예측 API의 관계 전용 Credential
LEARNING_PREDICTION_USERNAME=learning-service
LEARNING_PREDICTION_PASSWORD=replace-with-32-to-72-byte-secret
